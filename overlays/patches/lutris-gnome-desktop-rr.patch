Backport of upstream lutris commit fd91646fbae9 ("Check for deprecated
attributes in GnomeDesktop which have been removed in newer versions"),
which landed on master after the v0.5.22 release.

gnome-desktop >= 50 removed the deprecated gnome-rr bindings
(GnomeDesktop.RRScreen / RRConfig), but the nixpkgs FHS env still ships
its typelib, so lutris 0.5.22 crashed at import time with
AttributeError: 'gi.repository.GnomeDesktop' object has no attribute
'RRScreen'. Probe the attribute and fall back to the xrandr backend.

diff --git a/lutris/util/display.py b/lutris/util/display.py
--- a/lutris/util/display.py
+++ b/lutris/util/display.py
@@ -11,9 +11,12 @@
 try:
     gi.require_version("GnomeDesktop", "3.0")
     from gi.repository import GnomeDesktop  # type: ignore
+    # gnome-desktop >= 50 removed the deprecated gnome-rr bindings, so probe
+    # the attribute and fall back to the xrandr backend if it is gone.
+    GnomeDesktop.RRScreen  # type: ignore
 
     LIB_GNOME_DESKTOP_AVAILABLE = True
-except ValueError:
+except (ValueError, AttributeError):
     LIB_GNOME_DESKTOP_AVAILABLE = False
     GnomeDesktop = None
 
